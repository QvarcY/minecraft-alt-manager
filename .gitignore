# ============================================================
# Minecraft ALT Manager
# Public GitHub repository exclusions
# ============================================================

# Dependencies
node_modules/

# Generated release/build output
PORTABLE-BUILD/
_ARCHIVE/

# Local runtime data and secrets
data/secrets/
data/microsoft-auth/
PortableData/

# Local profile/settings data
data/profiles/
data/settings.json

# Local portable identity
.portable-id

# Runtime process/control files
manager.pid
manager.token
*.pid

# Secret / credential files
*.dat
*.secret
*.secrets
.env
.env.*
!.env.example

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp

# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store

# VS Code local workspace configuration
.vscode/

# JetBrains IDEs
.idea/

# npm cache/debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Coverage / test output
coverage/
.nyc_output/

# Generated archives
*.zip
*.7z
*.rar

# PowerShell temporary/backup files
*.bak
*.backup
*~
